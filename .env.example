# Gemini API key. Create your own key and keep the real .env out of Git.
GEMINI_API_KEY=

# A stable multimodal model with structured JSON support.
# Change this in .env if your account exposes a different model.
GEMINI_MODEL=gemini-3.1-flash-lite

# Required if you use the public OpenStreetMap Nominatim endpoint for the
# one-time 25-school campus-candidate step. Use an identifiable string.
# Example: SchoolFacilitiesCVTakeHome/0.1 (contact: your_email@example.com)
SCHOOL_CV_USER_AGENT=

# Gemini 3.1 Flash-Lite standard paid rates on 2026-09-03, in USD per
# 1,000,000 tokens. Verify against the current provider pricing page.
GEMINI_INPUT_USD_PER_1M=0.25
GEMINI_OUTPUT_USD_PER_1M=1.50
